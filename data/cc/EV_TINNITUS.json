[20,50,30]},{"label":"None of these","asserts":[],"denies":["EV_NASAL_CONGESTION","EV_NAUSEA","EV_VOMITING"],"vpk":null}]},{"id":"Q_FAINT","text":"Have you blacked out?","kind":"multi","category":"associated","priority":14,"chiefComplaints":["EV_DIZZINESS","EV_PALPITATIONS"],"universal":false,"exclusive":false,"optional":false,"options":[{"label":"I felt sick and clammy and my vision greyed out first","asserts":["EV_NAUSEA"],"denies":[],"vpk":[70,20,10]}]},{"id":"Q_CP_ASSOC","text":"Did any of these happen with the episode?","kind":"multi","category":"associated","priority":19,"chiefComplaints":["EV_CHEST_PAIN","EV_PALPITATIONS","EV_DYSPNEA"],"universal":false,"exclusive":false,"optional":false,"options":[{"label":"I felt sick or was sick","asserts":["EV_NAUSEA"],"denies":[],"vpk":[10,40,50]}]},{"id":"Q_MEASUREMENTS","text":"If you have measured any of these, what did you find?","kind":"multi","category":"associated","priority":90,"chiefComplaints":[],"universal":true,"exclusive":false,"optional":true,"options":[{"label":"Blood pressure top number above 180","asserts":["EV_BP_VERY_HIGH"],"denies":["EV_HYPOTENSION"],"vpk":[30,70,0]},{"label":"Blood pressure top number below 90","asserts":["EV_HYPOTENSION"],"denies":["EV_BP_VERY_HIGH"],"vpk":[80,0,20]},{"label":"Pulse faster than 100 at rest","asserts":["EV_TACHYCARDIA"],"denies":["EV_BRADYCARDIA"],"vpk":[40,60,0]},{"label":"Pulse slower than 50 at rest","asserts":["EV_BRADYCARDIA"],"denies":["EV_TACHYCARDIA"],"vpk":[30,0,70]},{"label":"Oxygen reading below 94 percent","asserts":["EV_HYPOXIA"],"denies":[],"vpk":[60,0,40]},{"label":"The veins in my neck stand out when I am sitting up","asserts":["EV_JVD"],"denies":[],"vpk":[30,0,70]},{"label":"I have not measured anything","asserts":[],"denies":[],"vpk":null}]}],"redFlags":[{"id":"RF_SEPSIS","label":"Possible sepsis","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":["EV_FEVER"],"anyOf":["EV_CONFUSION","EV_ALTERED_CONSCIOUSNESS","EV_TACHYPNEA","EV_HYPOTENSION","EV_COLD_PALE_LIMB","EV_RASH_NONBLANCHING"],"noneOf":[],"message":"A fever together with confusion, very fast breathing, mottled skin or a collapsing blood pressure can mean infection is affecting the whole body.","action":"Call emergency services now. Do not wait to see whether it settles.","guards":["CND_SEPSIS","CND_MENINGOCOCCAL_RASH","CND_PNEUMONIA","CND_PYELONEPHRITIS"]},{"id":"RF_NONBLANCHING_RASH","label":"Rash that does not fade under pressure","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":["EV_RASH_NONBLANCHING"],"anyOf":["EV_FEVER","EV_MALAISE","EV_HEADACHE","EV_CONFUSION","EV_VOMITING"],"noneOf":[],"message":"Spots that stay visible when a glass is pressed on them, alongside feeling unwell, can be a sign of bacteria in the bloodstream.","action":"Call emergency services now.","guards":["CND_MENINGOCOCCAL_RASH","CND_MENINGITIS","CND_SEPSIS"]},{"id":"RF_ANAPHYLAXIS","label":"Possible severe allergic reaction","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":[],"anyOf":["EV_STRIDOR"],"noneOf":[],"message":"Swelling of the throat or tongue with difficulty breathing after a food, sting, or medicine can close the airway within minutes.","action":"Use an adrenaline auto-injector if you have one, then call emergency services.","guards":["CND_ANAPHYLAXIS","CND_EPIGLOTTITIS"]},{"id":"RF_ALTERED_CONSCIOUSNESS","label":"Reduced consciousness","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":["EV_ALTERED_CONSCIOUSNESS"],"anyOf":[],"noneOf":[],"message":"Being difficult to rouse, or drifting in and out of awareness, always needs immediate assessment whatever the cause.","action":"Call emergency services now. Place the person on their side if unresponsive.","guards":["CND_SEPSIS","CND_MENINGITIS","CND_ICH","CND_DKA","CND_SAH"]},{"id":"RF_STROKE","label":"Possible stroke","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":["EV_ONSET_SUDDEN"],"anyOf":["EV_FACIAL_DROOP","EV_FOCAL_WEAKNESS","EV_SPEECH_DISTURBANCE"],"noneOf":[],"message":"Sudden facial drooping, arm weakness or difficulty speaking is a stroke until proven otherwise. Treatment works only within a few hours.","action":"Call emergency services now and note the exact time symptoms began.","guards":["CND_STROKE","CND_TIA","CND_ICH"]},{"id":"RF_SEIZURE_NEW","label":"Seizure","level":"URGENT","chiefComplaints":[],"universal":true,"allOf":["EV_SEIZURE"],"anyOf":[],"noneOf":[],"message":"A first seizure needs assessment to find the cause and to advise on driving and safety.","action":"Seek urgent assessment today. Call emergency services if the seizure lasted over five minutes or a second one followed.","guards":["CND_SEIZURE","CND_MENINGITIS","CND_ICH","CND_RAISED_ICP"]},{"id":"RF_GI_BLEED","label":"Significant gastrointestinal bleeding","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":[],"anyOf":["EV_HEMATEMESIS","EV_MELENA"],"noneOf":[],"message":"Vomiting blood, or passing black tarry stools, means bleeding inside the digestive tract.","action":"Go to an emergency department now.","guards":["CND_UPPER_GI_BLEED","CND_PEPTIC_ULCER"]},{"id":"RF_JAUNDICE","label":"New jaundice","level":"URGENT","chiefComplaints":[],"universal":true,"allOf":["EV_JAUNDICE"],"anyOf":[],"noneOf":[],"message":"Yellowing of the skin or eyes always needs blood tests to find out why.","action":"Seek same-day medical assessment.","guards":["CND_HEPATITIS","CND_CHOLECYSTITIS","CND_UPPER_GI_BLEED"]},{"id":"RF_VISION_LOSS","label":"Sudden loss of vision","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":["EV_VISION_LOSS_SUDDEN"],"anyOf":[],"noneOf":[],"message":"Sight lost suddenly in one or both eyes needs assessment the same hour, whatever the cause.","action":"Go to an eye emergency department now.","guards":["CND_ACUTE_GLAUCOMA","CND_GCA","CND_STROKE","CND_MS"]},{"id":"RF_SUICIDE","label":"Thoughts of self-harm","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":["EV_SUICIDAL_IDEATION"],"anyOf":[],"noneOf":[],"message":"Thoughts of harming yourself or of being better off dead deserve help today. You do not have to be in crisis to reach out.","action":"Contact your doctor, a crisis line, or go to an emergency department now. If you are in immediate danger, call emergency services.","guards":["CND_DEPRESSION"]},{"id":"RF_DELIRIUM","label":"New confusion coming on over hours or days","level":"EMERGENCY","chiefComplaints":[],"universal":true,"allOf":["EV_CONFUSION"],"anyOf":["EV_COGNITION_FLUCTUATES","EV_ONSET_ACUTE","EV_DUR_LT_1D","EV_ALTERED_CONSCIOUSNESS","EV_VISUAL_HALLUCINATION"],"noneOf":[],"message":"Confusion that has come on over hours or days, or that comes and goes through the day, is delirium until proven otherwise. It is caused by something else -- an infection, a drug, pain, retention -- and that cause needs finding today.","action":"Seek same-day medical assessment. Take a list of all medications. Call emergency services if they are drowsy, feverish or cannot be roused properly.","guards":["CND_DELIRIUM","CND_SEPSIS","CND_MENINGITIS","CND_DKA"]}],"disclaimer":"This tool provides information about possible causes of symptoms. It is not a diagnosis and it cannot examine you. It does not replace assessment by a qualified clinician. If you feel very unwell, or your symptoms are getting rapidly worse, seek medical help immediately regardless of what this tool says."}